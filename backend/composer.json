{
    "name": "synex/erp-backend",
    "type": "project",
    "description": "Synex ERP API - Laravel backend",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "tymon/jwt-auth": "^2.1",
        "spatie/laravel-query-builder": "^5.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^11.0",
        "nunomaduro/collision": "^8.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
    },
    "config": { "sort-packages": true, "optimize-autoloader": true }
}
